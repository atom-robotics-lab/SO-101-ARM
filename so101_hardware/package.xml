<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>so101_hardware</name>
  <version>0.1.0</version>
  <description>
    ros2_control SystemInterface for the real SO-101 arm. Bridges to
    feetech_bridge_node (Python, wraps lerobot) via ROS2 topics instead of
    talking to motors directly, reusing lerobot's tested calibration math.
  </description>
  <maintainer email="adityadevsingh16@gmail.com">your_name</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>sensor_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <hardware_interface plugin="${prefix}/so101_hardware.xml" />
  </export>
</package>
