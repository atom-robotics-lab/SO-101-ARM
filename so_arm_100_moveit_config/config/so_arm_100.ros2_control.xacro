<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
        <xacro:macro name="so_arm_100_ros2_control" params="name initial_positions_file use_fake_hardware prefix:=^|'' serial_port:=^|/dev/ttyUSB0 serial_baudrate:=^|1000000 servo_speed:=^|2400 servo_acceleration:=^|50" >        
        <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>

        <ros2_control name="${name}" type="system">
            <hardware>

                <plugin>so101_hardware/SO101HardwareInterface</plugin>
                <param name="commands_topic">/so101/hardware_commands</param>
                <param name="states_topic">/so101/hardware_states</param>

            </hardware>

        <joint name="${prefix}Shoulder_Rotation">
            <command_interface name="position">
            <param name="min">-1.8</param>
            <param name="max">1.8</param>
            <xacro:if value="${initial_positions_file != ''}">
                <xacro:property name="joint_name" value="${prefix}Shoulder_Rotation"/>
                <param name="initial_value">${initial_positions[joint_name]}</param>
            </xacro:if>
            </command_interface>
            <state_interface name="position"/>
            <!-- <state_interface name="velocity"/> -->
            <!-- <state_interface name="effort"/> -->
        </joint>
        <joint name="${prefix}Shoulder_Pitch">
            <command_interface name="position">
            <param name="min">-1.7</param>
            <param name="max">1.7</param>
            <xacro:if value="${initial_positions_file != ''}">
                <xacro:property name="joint_name" value="${prefix}Shoulder_Pitch"/>
                <param name="initial_value">${initial_positions[joint_name]}</param>
            </xacro:if>
            </command_interface>
            <state_interface name="position"/>
            <!-- <state_interface name="velocity"/> -->
            <!-- <state_interface name="effort"/> -->
        </joint>
        <joint name="${prefix}Elbow">
            <command_interface name="position">
            <param name="min">-1.5</param>
            <param name="max">1.5</param>
            <xacro:if value="${initial_positions_file != ''}">
                <xacro:property name="joint_name" value="${prefix}Elbow"/>
                <param name="initial_value">${initial_positions[joint_name]}</param>
            </xacro:if>
            </command_interface>
            <state_interface name="position"/>
            <!-- <state_interface name="velocity"/> -->
            <!-- <state_interface name="effort"/> -->
        </joint>
        <joint name="${prefix}Wrist_Pitch">
            <command_interface name="position">
            <param name="min">-1.658</param>
            <param name="max">1.658</param>
            <xacro:if value="${initial_positions_file != ''}">
                <xacro:property name="joint_name" value="${prefix}Wrist_Pitch"/>
                <param name="initial_value">${initial_positions[joint_name]}</param>
            </xacro:if>
            </command_interface>
            <state_interface name="position"/>
            <!-- <state_interface name="velocity"/> -->
            <!-- <state_interface name="effort"/> -->
        </joint>
        <joint name="${prefix}Wrist_Roll">
            <command_interface name="position">
            <param name="min">-2.75</param>
            <param name="max">2.75</param>
            <xacro:if value="${initial_positions_file != ''}">
                <xacro:property name="joint_name" value="${prefix}Wrist_Roll"/>
                <param name="initial_value">${initial_positions[joint_name]}</param>
            </xacro:if>
            </command_interface>
            <state_interface name="position"/>
            <!-- <state_interface name="velocity"/> -->
            <!-- <state_interface name="effort"/> -->
        </joint>
        <joint name="${prefix}Gripper">
            <command_interface name="position">
            <param name="min">-0.13</param>
            <param name="max">1.3</param>
            <xacro:if value="${initial_positions_file != ''}">
                <xacro:property name="joint_name" value="${prefix}Gripper"/>
                <param name="initial_value">${initial_positions[joint_name]}</param>
            </xacro:if>
            </command_interface>
            <state_interface name="position"/>
            <!-- <state_interface name="velocity"/> -->
            <!-- <state_interface name="effort"/> -->
        </joint>    

        </ros2_control>
    </xacro:macro>
</robot>
